# Bu dosyayı ".env" adıyla kopyalayın ve doldurun. .env dosyası GitHub'a YÜKLENMEZ.

# --- Telegram (önerilen) ---
# 1) Telegram'da @BotFather'a /newbot yazıp bot oluşturun, verilen token'ı buraya yazın
# 2) Botunuza bir mesaj atın, sonra tarayıcıda açın:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  ->  "chat":{"id": ...} değeri chat id'nizdir
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-posta (isteğe bağlı) ---
# Gmail için: Google Hesabı > Güvenlik > 2 Adımlı Doğrulama açık olmalı > "Uygulama şifreleri"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_KULLANICI=
SMTP_SIFRE=
EPOSTA_ALICI=
